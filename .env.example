APP_NAME="M.Y. Business Hotel HR"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Set a real local PostgreSQL URL; CHANGE_ME is intentionally rejected.
DATABASE_URL=
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional monthly report email. Leave empty to keep reports local-only.
REPORT_EMAIL_TO=
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_SMTP_STARTTLS=true
